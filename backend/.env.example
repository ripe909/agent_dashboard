# BACKEND_PORT is this app's own port. FRONTEND_PORT is the frontend's port — only needed so
# FRONTEND_URL below can reference it instead of hardcoding the number a second time; keep
# FRONTEND_PORT in sync with frontend/.env.local's own FRONTEND_PORT.
BACKEND_PORT=3001
FRONTEND_PORT=3000
OKTA_ORG_URL=https://your-org.okta.com
FRONTEND_URL=http://localhost:${FRONTEND_PORT}
BACKEND_PUBLIC_URL=http://localhost:${BACKEND_PORT}

# Name used to tag agents created via the request portal wizard — appears as a visible
# "[Name] " prefix on the agent's actual name in Okta, and is what the demo-reset endpoint
# matches on to find and clean up wizard-created agents. Should match the frontend's
# NEXT_PUBLIC_PORTAL_NAME (see frontend/.env.example) so the prefix reads consistently.
PORTAL_NAME=

# DB_MODE selects how local (non-Okta) app state — the owner cache and the
# resource catalog/connections — is stored:
#   postgres  (default) — requires DATABASE_URL, persists across restarts
#   memory              — no database needed, resets on every restart.
#                         Handy for a quick demo without Docker/Postgres.
DB_MODE=postgres
DATABASE_URL=postgresql://user:password@localhost:5432/okta_agents

# OKTA_AUTH_MODE selects how the backend authenticates to the Okta Management API:
#   api_token          (default) — static SSWS token via OKTA_API_TOKEN
#   client_credentials  — OAuth2 M2M via private_key_jwt (the org authorization
#                         server requires a signed JWT assertion, not a client secret)
OKTA_AUTH_MODE=api_token
OKTA_API_TOKEN=your-api-token

# Only used when OKTA_AUTH_MODE=client_credentials.
# OKTA_M2M_PRIVATE_JWK is the PRIVATE half of an RSA keypair whose PUBLIC half
# (same kid) is registered on the Okta API Services app's "Public Keys" tab.
OKTA_M2M_CLIENT_ID=your-api-services-client-id
OKTA_M2M_PRIVATE_JWK={"kty":"RSA","use":"sig","kid":"...","n":"...","e":"AQAB","d":"...","p":"...","q":"...","dp":"...","dq":"...","qi":"..."}

# Only used by the Chat feature (backend/src/routes/chat.ts), to call an OpenAI-compatible
# /chat/completions endpoint. LLM_BASE_URL has an internal fallback if unset — set it explicitly
# for your own LiteLLM (or compatible) host. LLM_MODEL has no default (leaving it unset will fail
# LLM calls) — set it to whatever model your endpoint serves. LLM_TEMPERATURE/LLM_MAX_TOKENS
# default to 0.7/1000 if unset.
# NOTE: this backend authenticates to that endpoint via the internal `ocm auth litellm` CLI
# (see getLiteLLMToken in chat.ts), not an API key env var — `ocm` must be installed and
# authenticated locally for Chat to work at all, regardless of these values.
LLM_BASE_URL=https://your-litellm-host/
LLM_MODEL=claude-sonnet-5
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000
