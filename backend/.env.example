PORT=3001
OKTA_ORG_URL=https://your-org.okta.com
FRONTEND_URL=http://localhost:3000

# DB_MODE selects how local (non-Okta) app state — the owner cache and the
# resource catalog/connections — is stored:
#   postgres  (default) — requires DATABASE_URL, persists across restarts
#   memory              — no database needed, resets on every restart.
#                         Handy for a quick demo without Docker/Postgres.
DB_MODE=postgres
DATABASE_URL=postgresql://user:password@localhost:5432/okta_agents

# OKTA_AUTH_MODE selects how the backend authenticates to the Okta Management API:
#   api_token          (default) — static SSWS token via OKTA_API_TOKEN
#   client_credentials  — OAuth2 M2M via private_key_jwt (the org authorization
#                         server requires a signed JWT assertion, not a client secret)
OKTA_AUTH_MODE=api_token
OKTA_API_TOKEN=your-api-token

# Only used when OKTA_AUTH_MODE=client_credentials.
# OKTA_M2M_PRIVATE_JWK is the PRIVATE half of an RSA keypair whose PUBLIC half
# (same kid) is registered on the Okta API Services app's "Public Keys" tab.
OKTA_M2M_CLIENT_ID=your-api-services-client-id
OKTA_M2M_PRIVATE_JWK={"kty":"RSA","use":"sig","kid":"...","n":"...","e":"AQAB","d":"...","p":"...","q":"...","dp":"...","dq":"...","qi":"..."}
