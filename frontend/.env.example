# FRONTEND_PORT is this app's own port — next dev only reads a port from the real process
# environment as PORT (not from this file, and not under this file's own FRONTEND_PORT name), so
# ./start_dashboard exports PORT=$FRONTEND_PORT for you; set PORT in your shell too if you're
# running next dev directly instead. BACKEND_PORT is the backend's port, only needed so
# BACKEND_URL/NEXT_PUBLIC_BACKEND_URL below can reference it instead of hardcoding the number a
# second time; keep it in sync with backend/.env's own BACKEND_PORT.
FRONTEND_PORT=3000
BACKEND_PORT=3001
NEXTAUTH_URL=http://localhost:${FRONTEND_PORT}
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
OKTA_CLIENT_ID=your-oidc-web-app-client-id
OKTA_CLIENT_SECRET=your-oidc-web-app-client-secret
OKTA_ISSUER=https://your-org.okta.com/oauth2/default
BACKEND_URL=http://localhost:${BACKEND_PORT}
NEXT_PUBLIC_BACKEND_URL=http://localhost:${BACKEND_PORT}
# Client-side mirrors of the backend's own OKTA_ORG_URL/OKTA_AUTH_MODE (backend/.env.example) —
# the browser can't read server env vars, so these are duplicated here purely for UI purposes:
# building admin-console deep links and labeling M2M vs SSWS calls in the Events panel
# (components/EventLog.tsx). Should match the backend's values.
NEXT_PUBLIC_OKTA_ORG=https://your-org.okta.com
NEXT_PUBLIC_OKTA_AUTH_MODE=api_token
# Request-portal branding — all optional. Controls the (request) route's identity, logo,
# colours, and the agent-name prefix it creates. If unset, defaults to a generic "Agent
# Request" identity with no logo. Must match backend's PORTAL_NAME (backend/.env.example) so
# the agent-name prefix reads consistently with the portal's own branding.
NEXT_PUBLIC_PORTAL_NAME=Agent Request
NEXT_PUBLIC_PORTAL_TAGLINE=Agent Onboarding Portal
# Path under /public (e.g. /your-logo.png) or a full external URL. Leave blank for no logo.
NEXT_PUBLIC_PORTAL_LOGO_PATH=
NEXT_PUBLIC_PORTAL_LOGO_ALT=Company logo
# Hex colours overriding the portal theme's defaults (see .agent-request-theme in app/globals.css).
NEXT_PUBLIC_PORTAL_PRIMARY_COLOR=
NEXT_PUBLIC_PORTAL_ACCENT_COLOR=
